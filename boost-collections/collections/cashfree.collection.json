        {
          "name": "Fetch Refund by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-client-id", "value": "{{cashfree_app_id}}" },
              { "key": "x-client-secret", "value": "{{cashfree_secret_key}}" },
              { "key": "x-api-version", "value": "2023-08-01" }

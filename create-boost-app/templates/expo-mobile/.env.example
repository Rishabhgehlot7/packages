# ==============================================================================
# Boost Mobile App - Environment Variables Template
# ==============================================================================

# API (backend-express base URL)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Payments (UPI / Razorpay / Cashfree / PhonePe)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
EXPO_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id
EXPO_PUBLIC_PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
EXPO_PUBLIC_PHONEPE_SALT_KEY=your_phonepe_salt_key

# Shiprocket (Logistics)
EXPO_PUBLIC_SHIPROCKET_EMAIL=you@yourdomain.com
EXPO_PUBLIC_SHIPROCKET_PASSWORD=your_shiprocket_password

# Push Notifications
EXPO_PUBLIC_NOTIFICATIONS_ENABLED=true

# JWT Auth
EXPO_PUBLIC_JWT_SECRET=your_super_secret_jwt_key_here

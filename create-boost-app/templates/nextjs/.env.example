# ==============================================================================
# Boost D2C Store - Environment Variables Template
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/boost-store

# Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Cashfree
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# PhonePe
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1

# Shiprocket (Logistics)
SHIPROCKET_EMAIL=you@yourdomain.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# JWT Auth
JWT_SECRET=your_super_secret_jwt_key_here

# Cloud Storage (AWS S3)
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your_access_key
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your_secret_key

# Notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=BOOST

# ==============================================================================
# Boost D2C Store - Environment Variables Template
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/boost-store

# Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Cloud Storage (AWS S3)
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your_access_key
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your_secret_key

# Notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=BOOST

{
  "name": "@boostengine/recommendations",
  "version": "1.0.1",
  "description": "Amazon & Flipkart-style Frequently Bought Together (FBT) bundles, cross-sell, and upsell recommendation engine for Next.js, Vite, and React.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "node test-suite.cjs"
  },
  "keywords": [
    "recommendations",
    "frequently-bought-together",
    "cross-sell",
    "upsell",
    "bundle-deals",
    "average-order-value",
    "ecommerce",
    "nextjs",
    "vite",
    "react",
    "d2c",
    "boostengine"
  ],
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boostengine/boostengine.git",
    "directory": "packages/boost-recommendations"
  },
  "homepage": "https://github.com/boostengine/boostengine#readme",
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}

{
  "name": "@boostengine/ui",
  "version": "1.2.0",
  "description": "Pre-Built High-Converting eCommerce UI Components for Next.js & React: Cart Drawer, Mobile Sticky Buy Bar, Pincode Delivery Checker, Trust Badges & Order Timeline.",
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ui",
    "react-ecommerce",
    "cart-drawer",
    "sticky-add-to-cart",
    "pincode-checker",
    "trust-badges",
    "order-timeline",
    "nextjs-ui"
  ],
  "bin": {
    "boost-ui": "./bin/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}

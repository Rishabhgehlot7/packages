{
  "name": "@boostengine/ui",
  "version": "1.8.2",
  "description": "Universal, Zero-Config UI Component Suite for Next.js & React. Build High-Converting eCommerce, Modern SaaS, Enterprise Dashboards, and Landing Pages with AI Agent Native Support.",
  "author": "Rishabh Gehlot <boostengine001@gmail.com> (https://github.com/Rishabhgehlot7)",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Rishabhgehlot7"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react-ui",
    "nextjs-ui",
    "ui-components",
    "ecommerce-ui",
    "saas-ui",
    "dashboard-ui",
    "landing-page-components",
    "zero-config",
    "zero-dependency",
    "dark-mode",
    "theming",
    "design-system",
    "shadcn-alternative",
    "radix-ui",
    "tailwind-free",
    "ai-agent-friendly",
    "llms-txt",
    "cart-drawer",
    "product-gallery",
    "pricing-table",
    "hero-section",
    "command-palette",
    "d2c",
    "headless-commerce",
    "react-hooks",
    "utility-functions",
    "useMediaQuery",
    "useCopyToClipboard",
    "useForm",
    "formatCurrency",
    "indian-ecommerce",
    "upi-checkout",
    "svg-charts",
    "accessible-ui"
  ],
  "homepage": "https://github.com/Rishabhgehlot7/packages/tree/main/boost-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rishabhgehlot7/packages.git",
    "directory": "boost-ui"
  },
  "bugs": {
    "url": "https://github.com/Rishabhgehlot7/packages/issues"
  },
  "bin": {
    "boost-ui": "./bin/cli.cjs",
    "ui": "./bin/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./dist/tokens.json",
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "hooks": [
        "./dist/hooks/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "src/components",
    "src/tokens.json",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node test-suite.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
